# Copy this file to .env and fill in your values. Never commit .env.

PORT=5000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/bagang_dental
# MongoDB Atlas (replace user, password, cluster host):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bagang_dental?retryWrites=true&w=majority

# Allowed browser origin(s) for CORS, comma-separated. Vite dev server by default.
CLIENT_ORIGIN=http://localhost:5173

# Secret used by clinic staff to list bookings and change their status.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=change-me

# Timezone used to decide what "tomorrow" and "Sunday" mean for bookings.
CLINIC_TIMEZONE=Asia/Manila
